# Copiar como .env (local) o cargar en Vercel → Settings → Environment Variables. Nunca subir .env a GitHub.
# Neon: usar la cadena de conexión DIRECTA (sin "-pooler" en el host), con sslmode=require.
DATABASE_URL=postgresql://usuario:clave@host:5432/bodega?sslmode=require
# Mínimo 32 caracteres. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_HORAS_VALIDEZ=12
# Orígenes permitidos (app Android con Capacitor = https://localhost; Vite en desarrollo = http://localhost:5173)
ORIGENES_CORS=https://localhost,http://localhost,capacitor://localhost,http://localhost:5173
# En Vercel (serverless) basta 2; en un servidor tradicional 5-10.
TAMANO_POOL=2
